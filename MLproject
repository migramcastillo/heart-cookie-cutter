name: heart-ccds

entry_points:
  main:
    parameters:
      data: {type: path, default: data/raw/heart.csv}
      n_estimators: {type: int, default: 100}
      max_depth: {type: string, default: "None"}
      min_samples_split: {type: int, default: 2}
      min_samples_leaf: {type: int, default: 1}
      random_state: {type: int, default: 42}
    command: >-
      python main.py
      --data {data}
      --n-estimators {n_estimators}
      --max-depth {max_depth}
      --min-samples-split {min_samples_split}
      --min-samples-leaf {min_samples_leaf}
      --random-state {random_state}

  load:
    parameters:
      input_path: {type: path, default: data/raw/heart.csv}
      output_path: {type: path, default: data/interim/interim.csv}
    command: >-
      python -m heart_ccds.dataset
      --input-path {input_path}
      --output-path {output_path}

  features:
    parameters:
      data: {type: path, default: data/raw/heart.csv}
      test_size: {type: float, default: 0.2}
      random_state: {type: int, default: 42}
    command: >-
      python -m heart_ccds.features
      --data {data}
      --test-size {test_size}
      --random-state {random_state}

  train:
    parameters:
      data: {type: path, default: data/raw/heart.csv}
      n_estimators: {type: int, default: 100}
      max_depth: {type: string, default: "None"}
      min_samples_split: {type: int, default: 2}
      min_samples_leaf: {type: int, default: 1}
      random_state: {type: int, default: 42}
    command: >-
      python -m heart_ccds.modeling.train
      --data {data}
      --n-estimators {n_estimators}
      --max-depth {max_depth}
      --min-samples-split {min_samples_split}
      --min-samples-leaf {min_samples_leaf}
      --random-state {random_state}

  predict:
    parameters:
      model_uri: {type: string}
      data: {type: path, default: data/processed/test.csv}
    command: >-
      python -m heart_ccds.modeling.predict
      --model-uri {model_uri} --data {data}
